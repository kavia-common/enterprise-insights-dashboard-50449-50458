# Environment variables used by the dashboard_frontend (do not commit .env with secrets)

# Base URL for backend API (preferred). Example: https://api.example.com
REACT_APP_API_BASE=

# Alternative backend URL if API base not set
REACT_APP_BACKEND_URL=

# WebSocket URL if used by other features (optional)
REACT_APP_WS_URL=

# Feature flags (comma-separated). To enable inventory feature:
# Example: REACT_APP_FEATURE_FLAGS=inventory=true
REACT_APP_FEATURE_FLAGS=inventory=true

# Experiments toggle (optional)
REACT_APP_EXPERIMENTS_ENABLED=false

# Optional: other envs that might be present in the container
REACT_APP_FRONTEND_URL=
REACT_APP_NODE_ENV=development
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health
